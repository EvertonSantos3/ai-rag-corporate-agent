# API da Groq — gratuita, sem necessidade de cartão de crédito.
# Crie sua chave em https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nota: no Streamlit Community Cloud, NÃO use este arquivo .env — configure a mesma
# variável em Settings > Secrets do app, no formato:
#   GROQ_API_KEY = "gsk_..."
